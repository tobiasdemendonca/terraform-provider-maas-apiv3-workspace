# Copy to .env and fill in values. Never commit .env.
# MAAS runs outside Workshop (host or LAN). Only the URL and API key are required
# for agent/CLI access; username/password are optional for the current provider
# acceptance-test login path.
MAAS_API_URL=http://127.0.0.1:5240/MAAS/
MAAS_API_KEY=
MAAS_USERNAME=admin
MAAS_PASSWORD=
